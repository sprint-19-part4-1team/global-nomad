{
  "name": "global-nomad",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "typegen": "next typegen",
    "generate:tokens": "node scripts/generateTokens.js",
    "optimize:svg": "svgo src/assets --recursive",
    "dev": "pnpm generate:tokens && next dev --turbopack",
    "build": "pnpm generate:tokens && next build",
    "start": "next start",
    "lint": "eslint src",
    "lint:fix": "eslint --fix src",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "prepare": "husky",
    "storybook": "pnpm generate:tokens && storybook dev -p 6006",
    "build-storybook": "pnpm generate:tokens && storybook build",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "lint-staged": {
    "src/assets/**/*.svg": [
      "svgo"
    ],
    "**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,md,html}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.16",
    "@types/react-slick": "^0.23.13",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "next": "15.5.9",
    "react": "19.2.3",
    "react-daum-postcode": "^3.2.0",
    "react-day-picker": "^9.13.0",
    "react-dom": "19.2.3",
    "react-slick": "^0.31.0",
    "react-toastify": "^11.0.5",
    "slick-carousel": "^1.8.1",
    "tailwind-merge": "^3.4.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@eslint/eslintrc": "^3",
    "@storybook/addon-a11y": "^10.1.10",
    "@storybook/addon-docs": "^10.1.10",
    "@storybook/nextjs": "^10.1.10",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4",
    "@tanstack/eslint-plugin-query": "^5.91.2",
    "@tanstack/react-query-devtools": "^5.91.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "chromatic": "^13.3.4",
    "eslint": "^9",
    "eslint-config-next": "15.5.9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-storybook": "^10.1.10",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "storybook": "^10.1.10",
    "svgo": "^4.0.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
